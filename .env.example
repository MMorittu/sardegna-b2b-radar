# Optional Lightweight LLM Refiner for ambiguous CME items (100% deterministic offline when empty)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Configurable Company & Logistics Hub Ground Truth
COMPANY_NAME="Sardinian Precast Concrete & Construction Supplier"
