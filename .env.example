# Sardegna B2B Tender & Procurement Radar — Environment Configuration
SARDEGNA_RADAR_DB_PATH=data/sardegna_radar.db
SARDEGNA_RADAR_MIN_ALERT_SCORE=45.0
SARDEGNA_RADAR_HTTP_TIMEOUT_SECONDS=15.0
SARDEGNA_RADAR_HTTP_CONNECT_TIMEOUT_SECONDS=30.0
SARDEGNA_RADAR_HTTP_MAX_RETRIES=3
SARDEGNA_RADAR_ADAPTIVE_STORAGE_DIR=data/adaptive_selectors

# Optional Telegram Alerting (degrades gracefully to Rich CLI/Markdown when empty)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Company Origin Base (Configurable via .env)
COMPANY_NAME="Sardegna Prefabbricati C.A.V. S.r.l."
COMPANY_PIVA="00000000000"
COMPANY_BASE_MUNICIPALITY="Silanus"
COMPANY_BASE_PROVINCE="NU"
